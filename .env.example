# guarded-mini environment — COPY THIS TO .env ONLY IF YOUR SHELL DOES NOT EXPORT THEM.
#
# The harness reads credentials from the *environment* at runtime; it never reads
# a .env file itself and never writes these values anywhere. Keys are empty on
# purpose: this file is a documented placeholder (hackathon compliance rule 6).
#
#   export AI_API_KEY=...        # the ONLY credential; provided by the evaluator
#   export MODEL_BASE_URL=...    # OpenAI-compatible base URL, e.g. https://host/v1
#   export MODEL_NAME=...        # e.g. deepseek-chat or qwen-max
#
# Optional:
#   export HARNESS_WORKSPACE=/path/to/target-repo   # default: current directory
#   export MSWEA_MODEL_RETRY_STOP_AFTER_ATTEMPT=3   # upstream retry cap

AI_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
