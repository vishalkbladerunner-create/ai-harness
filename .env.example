# guarded-mini environment — COPY THIS TO .env ONLY IF YOUR SHELL DOES NOT EXPORT THEM.
#
# The harness reads credentials from the *environment* at runtime; it never reads
# a .env file itself and never writes these values anywhere. Keys are empty on
# purpose: this file is a documented placeholder (hackathon compliance rule 8).
#
#   export AI_API_KEY=...        # REQUIRED: the only credential, provided by the evaluator
#
# Optional — the harness has checked-in provider defaults (DeepSeek first, then
# Qwen/DashScope) and discovers the right one from the key, so these are only
# needed if the committee prescribes a specific endpoint/model:
#
#   export MODEL_BASE_URL=https://api.deepseek.com/v1     # or https://dashscope.aliyuncs.com/compatible-mode/v1
#   export MODEL_NAME=deepseek-chat                        # or qwen-plus / qwen-max
#
# Other optional knobs:
#   export HARNESS_WORKSPACE=/path/to/target-repo   # default: issue hint, cwd, or repo named in the issue
#   export MSWEA_MODEL_RETRY_STOP_AFTER_ATTEMPT=3   # upstream retry cap

AI_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
